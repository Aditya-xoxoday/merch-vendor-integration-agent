{
  "<vendorId: check existing PRINTSTPMERCHANDISE_VENDOR_ID>": {
    "vendorData": {
      "vendorId": "<vendorId: check existing PRINTSTPMERCHANDISE_VENDOR_ID>",
      "vendorType": "fixedSku",
      "name": "Printstop",
      "model": "printstop_merchandise",
      "merchandiseVendor": true,
      "iswebhookConfiration": true
    },
    "vendorTableMapping": {
      "table": "printstop_merchandise_products",
      "extraInfo": false,
      "countryColumn": "",
      "currencyColumn": "",
      "skuTable": "printstop_merchandise_product_to_denominations"
    },
    "placeOrderReqConfigs": {
      "url": "/services/api.php?method=order",
      "method": "POST",
      "body": {}
    },
    "refetchOrderReqConfigs": {
      "url": "/services/api.php?method=order_status&orders_id={orders_id}",
      "method": "POST"
    },
    "accessTokenConfigs": {
      "url": "/services/api.php?method=generate_token&corporate_id={corporate_id}",
      "method": "GET"
    },
    "webhookConfigs": {
      "isDataEncrypted": false,
      "orderStatus": {
        "in production": "CONFIRMED"
      }
    },
    "productListingConfigs": {
      "method": "POST",
      "getProducts": "/services/api.php?method=product_listing"
    },
    "configs": {
      "baseUrl": "https://www.psstaging.in",
      "maxApiAtaTime": 1,
      "maxCardsPerRequest": 1,
      "pickConfigCustomerInfo": false,
      "credentials": {
        "printstop": {
          "clientId": "{{client_id}}",
          "clientSecret": "{{client_secret}}",
          "userName": "{{client_email}}",
          "corporateId": "{{corporate_id}}",
          "companyName": "{{company_name}}",
          "corporateBillingId": "{{corporate_billing_id}}",
          "orderEmail": "{{order_email}}"
        }
      }
    }
  }
}
