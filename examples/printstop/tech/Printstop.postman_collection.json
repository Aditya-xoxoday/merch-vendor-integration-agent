  "item": [
    {
      "name": "00 Auth: get token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('has access_token', () => pm.expect(j).to.have.property('access_token'));",
              "if (pm.response.code === 200) pm.collectionVariables.set('access_token', pm.response.json()['access_token']);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "client-secret",
            "value": "{{client_secret}}"
          },
          {
            "key": "client-id",
            "value": "{{client_id}}"
          },
          {
            "key": "user-name",
            "value": "{{client_email}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/services/api.php?method=generate_token&corporate_id={{corporate_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "services",
            "api.php"
          ],
          "query": [
            {
              "key": "method",
              "value": "generate_token"
            },
            {
              "key": "corporate_id",
              "value": "{{corporate_id}}"
            }
          ]
        }
      }
    },
