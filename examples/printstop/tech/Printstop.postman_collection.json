    {
      "name": "05 Track order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('has orders_id', () => pm.expect(j).to.have.property('orders_id'));",
              "pm.test('has orders_status_id', () => pm.expect(j).to.have.property('orders_status_id'));",
              "pm.test('has orders_status', () => pm.expect(j).to.have.property('orders_status'));",
              "pm.test('has orders_due_date', () => pm.expect(j).to.have.property('orders_due_date'));",
              "pm.test('has actual_delivery_date', () => pm.expect(j).to.have.property('actual_delivery_date'));",
              "pm.test('has tracking_number', () => pm.expect(j).to.have.property('tracking_number'));",
              "pm.test('has tracking_url', () => pm.expect(j).to.have.property('tracking_url'));",
              "pm.test('has shipping_company', () => pm.expect(j).to.have.property('shipping_company'));"
            ]
          }
        }
